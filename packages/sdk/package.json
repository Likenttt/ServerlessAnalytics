{
  "name": "@serverless-analytics/sdk",
  "version": "0.1.0",
  "description": "Browser / Electron / Node client for Serverless Analytics",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --target=es2020 --outfile=dist/index.js && esbuild src/global.ts --bundle --format=iife --target=es2019 --minify --outfile=dist/analytics.global.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
