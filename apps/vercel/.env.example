# Vercel → Project → Settings → Environment Variables. See docs/CONFIGURATION.md.
ADMIN_PASSWORD=change-me-please
# Supabase: use the pooler ("Transaction" mode, port 6543) connection string.
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Optional cache (Upstash Redis, also set automatically by the Vercel Upstash integration).
KV_DRIVER=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QUEUE_DRIVER=direct
# Protects /api/cron/retention (Vercel Cron sends it automatically).
CRON_SECRET=
